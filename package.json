{
  "name": "reedmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4177 --strictPort",
    "build:fixed": "vite build --mode fixed",
    "build:pool": "vite build --mode pool",
    "check": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "balance": "node --disable-warning=ExperimentalWarning scripts/balance.ts",
    "test:browser": "playwright test",
    "face-art": "node --disable-warning=ExperimentalWarning scripts/make-face-art.ts",
    "docs": "node --disable-warning=ExperimentalWarning scripts/export-docs.ts",
    "docs:check": "node --disable-warning=ExperimentalWarning scripts/export-docs.ts --check"
  },
  "dependencies": { "three": "0.187.0" },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22.0.0",
    "@types/three": "^0.185.0",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}